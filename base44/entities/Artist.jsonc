{
  "name": "Artist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "name_ar": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "bio_ar": {
      "type": "string"
    },
    "genre": {
      "type": "string",
      "enum": [
        "khaliji",
        "swahili",
        "egyptian",
        "other"
      ],
      "default": "other"
    },
    "monthly_listeners": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}