{
  "name": "Track",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "title_ar": {
      "type": "string"
    },
    "isrc": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "artist_ar": {
      "type": "string"
    },
    "album": {
      "type": "string"
    },
    "album_ar": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "duration": {
      "type": "number",
      "default": 0
    },
    "genre": {
      "type": "string"
    },
    "genre_ar": {
      "type": "string"
    },
    "playlist": {
      "type": "string"
    },
    "playlist_ar": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ],
      "default": "ar"
    },
    "plays": {
      "type": "number",
      "default": 0
    },
    "composer": {
      "type": "string"
    },
    "composer_ar": {
      "type": "string"
    },
    "lyricist": {
      "type": "string"
    },
    "lyricist_ar": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "release_year": {
      "type": "number"
    },
    "maqam_genre": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "audio_url"
  ]
}